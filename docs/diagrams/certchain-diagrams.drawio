5-4" value="&lt;p style=&quot;margin:0;text-align:center;background:#FBF3E8&quot;&gt;&lt;b&gt;certificates&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 8px;text-align:left;font-family:Consolas,monospace;font-size:11px&quot;&gt;PK  _id                ObjectId&lt;br&gt;    certificateId        String  unique&lt;br&gt;    recipientName        String&lt;br&gt;    recipientEmail       String&lt;br&gt;    courseName           String&lt;br&gt;    courseDescription    String&lt;br&gt;FK  issuedBy            ObjectId -&amp;gt; users._id&lt;br&gt;    organizationName     String&lt;br&gt;    issueDate            Date&lt;br&gt;    expiryDate           Date  (nullable)&lt;br&gt;    certificateHash      String  (SHA-256)&lt;br&gt;    blockchainTxHash     String&lt;br&gt;    blockchainNetwork    String&lt;br&gt;    status               active | expired | revoked&lt;br&gt;    revokedAt            Date  (nullable)&lt;br&gt;    revokedReason        String  (nullable)&lt;br&gt;    pdfPath              String&lt;br&gt;    createdAt            Date&lt;br&gt;    updatedAt            Date&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E1A36F;fontColor=#1F2E33;fontSize=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="55" width="390" height="344" as="geometry"/></mxCell><mxCell id="p5-5" value="issues" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;" edge="1" parent="1" source="p5-3" target="p5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-6" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;" vertex="1" connectable="0" parent="p5-5"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometr