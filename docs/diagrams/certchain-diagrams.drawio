ields&lt;br&gt;&lt;br&gt;certificateId&lt;br&gt;recipientName&lt;br&gt;recipientEmail&lt;br&gt;courseName&lt;br&gt;organizationName&lt;br&gt;issueDate&lt;br&gt;expiryDate" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E3EFEE;strokeColor=#6F9F9C;fontColor=#1F2E33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="95" width="190" height="200" as="geometry"/></mxCell><mxCell id="p6-6" value="JSON.stringify&lt;br&gt;then SHA-256" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#577E89;fontColor=#1F2E33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="150" height="70" as="geometry"/></mxCell><mxCell id="p6-7" value="dataHash&lt;br&gt;0x... (32 bytes)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#577E89;fontColor=#1F2E33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="235" width="150" height="60" as="geometry"/></mxCell><mxCell id="p6-8" value="ethers.js v6&lt;br&gt;signer = backend&lt;br&gt;wallet" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FBF3E8;strokeColor=#E1A36F;fontColor=#1F2E33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="140" height="90" as="geometry"/></mxCell><mxCell id="p6-9" value="Infura&lt;br&gt;JSON-RPC (HTTPS)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F3EFE0;strokeColor=#B9B08A;fontColor=#1F2E33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="160" height="60" as="geometry"/></mxCell><mxCell id="p6-10" value="CertificateRegistry (owner = backend wallet)&lt;br&gt;&lt;br&gt;mapping(string =&amp;gt; Certificate)&lt;br&gt;storeCertificate  revokeCertificate&lt;br&gt;getCertificate  verifyCertificate&lt;br&gt;certificateExistsOnChain" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#577E89;strokeColor=#3F6370;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="215" width="340" height="140" as="geometry"/></mxCell><mxCell id="p6-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p6-5" target="p6-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;endArrow=block;endFill=1;" edge="1" parent="1" source="p6-6" target="p6-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.5;entryY=1.0;endArrow=block;endFill=1;" edge="1" parent="1" source="p6-7" target="p6-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-14" value="signed tx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p6-8" target="p6-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;endArrow=block;endFill=1;" edge="1" parent="1" source="p6-9" target="p6-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-16" value="Issue&lt;br&gt;storeCertificate(id, hash) records the hash,&lt;br&gt;the issuing address and the time" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#577E89;fontColor=#1F2E33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="300" height="70" as="geometry"/></mxCell><mxCell id="p6-17" value="Revoke&lt;br&gt;revokeCertificate(id) sets isRevoked = true&lt;br&gt;(owner only, cannot be undone)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#577E89;fontColor=#1F2E33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="430" width="300" height="70" as="geometry"/></mxCell><mxCell id="p6-18" value="Verify&lt;br&gt;backend recomputes the hash and compares it&lt;br&gt;with the on-chain hash and the revoked flag" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#577E89;fontColor=#1F2E33;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="430" width="300" height="70" as="geometry"/></mxCell><mxCell id="p6-19" value="Simulation mode (no RPC URL, key or contract address in .env): the same hash is computed, the transaction hash is a mock value and nothing is written on-chain." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#55696F;" vertex="1" parent="1"><mxGeometry x="30" y="549" width="600" height="19" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7 Smart contract"><mxGraphModel dx="1100" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7-2" value="Figure 7. Smart contract design: CertificateRegistry.sol" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=16;fontColor=#1F2E33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="14" width="600" height="24" as="geometry"/></mxCell><mxCell id="p7-3" value="&lt;p style=&quot;margin:0;text-align:center;background:#FBF3E8&quot;&gt;&lt;b&gt;CertificateRegistry&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 8px;text-align:left;font-family:Consolas,monospace;font-size:11px&quot;&gt;+ owner : address&lt;br&gt;+ totalCertificates : uint256&lt;br&gt;- certificates : mapping(string =&amp;gt; Certificate)&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 8px;text-align:left;font-family:Consolas,monospace;font-size:11px&quot;&gt;+ storeCertificate(certificateId : string, dataHash : bytes32)&lt;br&gt;      onlyOwner&lt;br&gt;+ revokeCertificate(certificateId : string)&lt;br&gt;      onlyOwner, certificateExists, certificateNotRevoked&lt;br&gt;+ getCertificate(certificateId : string)&lt;br&gt;      returns (id, dataHash, issuedBy, issuedAt, isRevoked)&lt;br&gt;+ certificateExistsOnChain(certificateId : string) : bool&lt;br&gt;+ verifyCertificate(certificateId : string, dataHash : bytes32) : bool&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E1A36F;fontColor=#1F2E33;fontSize=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="470" height="226" as="geometry"/></mxCell><mxCell id="p7-4" value="&lt;p style=&quot;margin:0;text-align:center;background:#E3EFEE&quot;&gt;&lt;b&gt;struct Certificate&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 8px;text-align:left;font-family:Consolas,monospace;font-size:11px&quot;&gt;certificateId : string&lt;br&gt;dataHash : bytes32&lt;br&gt;issuedBy : address&lt;br&gt;issuedAt : uint256&lt;br&gt;isRevoked : bool&lt;br&gt;exists : bool&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6F9F9C;fontColor=#1F2E33;fontSize=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="250" height="136" as="geometry"/></mxCell><mxCell id="p7-5" value="&lt;p style=&quot;margin:0;text-align:center;background:#F3EFE0&quot;&gt;&lt;b&gt;Events&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 8px;text-align:left;font-family:Consolas,monospace;font-size:11px&quot;&gt;CertificateIssued(&lt;br&gt;  certificateId (indexed),&lt;br&gt;  dataHash,&lt;br&gt;  issuedBy (indexed),&lt;br&gt;  issuedAt)&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 8px;text-align:left;font-family:Consolas,monospace;font-size:11px&quot;&gt;CertificateRevoked(&lt;br&gt;  certificateId (indexed),&lt;br&gt;  revokedAt)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B9B08A;fontColor=#1F2E33;fontSize=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="850" y="80" width="220" height="178" as="geometry"/></mxCell><mxCell id="p7-6" value="&lt;p style=&quot;margin:0;text-align:center;background:#E4EDF0&quot;&gt;&lt;b&gt;Modifiers&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0 0 0 8px;text-align:left;font-family:Consolas,monospace;font-size:11px&quot;&gt;onlyOwner&lt;br&gt;certificateExists(id)&lt;br&gt;certificateNotRevoked(id)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#577E89;fontColor=#1F2E33;fontSize=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="250" height="88" as="geometry"/></mxCell><mxCell id="p7-7" value="stores 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p7-3" target="p7-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-8" value="emits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p7-3" target="p7-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-9" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=1.0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p7-3" target="p7-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-10" value="Rules enforced on-chain" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=13;fontColor=#1F2E33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="417" width="600" height="21" as="geometry"/></mxCell><mxCell id="p7-11" value="- Only the owner (the address that deployed the contract) can store or revoke." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#1F2E33;" vertex="1" parent="1"><mxGeometry x="330" y="442" width="600" height="20" as="geometry"/></mxCell><mxCell id="p7-12" value="- A certificateId can be stored once; storing it again reverts." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#1F2E33;" vertex="1" parent="1"><mxGeometry x="330" y="462" width="600" height="20" as="geometry"/></mxCell><mxCell id="p7-13" value="- A revoked certificate cannot be revoked again, and verifyCertificate returns false for it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#1F2E33;" vertex="1" parent="1"><mxGeometry x="330" y="482" width="600" height="20" as="geometry"/></mxCell><mxCell id="p7-14" value="- Reads (getCertificate, verifyCertificate, certificateExistsOnChain) are free view calls." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#1F2E33;" vertex="1" parent="1"><mxGeometry x="330" y="502" width="600" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8 Certificate status"><mxGraphModel dx="1000" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8-2" value="Figure 8. Certificate status lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=16;fontColor=#1F2E33;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="14" width="600" height="24" as="geometry"/></mxCell><mxCell id="p8-3" value="" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#577E89;strokeColor=#3F6370;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="40" height="40" as="geometry"/></mxCell><mxCell id="p8-4" value="ACTIVE&lt;br&gt;status = active" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E6F2EA;strokeColor=#2F7D4F;fontColor=#1F2E33;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="170" width="190" height="80" as="geometry"/></mxCell><mxCell id="p8-5" value="EXPIRED&lt;br&gt;expiryDate has passed" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F7ECD8;strokeColor=#A66A12;fontColor=#1F2E33;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="190" height="80" as="geometry"/></mxCell><mxCell id="p8-6" value="REVOKED&lt;br&gt;revokedAt + reason stored" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F6E1DE;strokeColor=#B3382C;fontColor=#1F2E33;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="260" width="190" height="80" as="geometry"/></mxCell><mxCell id="p8-7" value="" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#577E89;strokeColor=#3F6370;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="635" y="375" width="40" height="40" as="geometry"/></mxCell><mxCell id="p8-8" value="issue:&lt;br&gt;storeCertificate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p8-3" target="p8-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8-9" value="expiry date passes&lt;br&gt;(checked on every read)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p8-4" target="p8-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="485" y="210"/><mxPoint x="485" y="130"/></Array></mxGeometry></mxCell><mxCell id="p8-10" value="revoke by owner" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p8-4" target="p8-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="485" y="210"/><mxPoint x="485" y="300"/></Array></mxGeometry></mxCell><mxCell id="p8-11" value="revoke by owner" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;entryX=1.0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="p8-5" target="p8-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="130"/><mxPoint x="810" y="300"/></Array></mxGeometry></mxCell><mxCell id="p8-12" value="end of life" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3F6370;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;endArrow=block;endFill=1;" edge="1" parent="1" source="p8-6" target="p8-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8-13" value="A certificate with no expiry date stays ACTIVE until it is revoked." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#55696F;" vertex="1" parent="1"><mxGeometry x="220" y="428" width="600" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>