# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────
# Local:  mongodb://localhost:27017/certchain
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/certchain
MONGODB_URI=mongodb://localhost:27017/certchain

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# ─── Ethereum / Blockchain ───────────────────────────────
# Leave blank to use simulation mode (no real blockchain)
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
DEPLOYER_PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# ─── Email (Nodemailer) ──────────────────────────────────
# Gmail example — use an App Password, not your main password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="CertChain Platform <your.email@gmail.com>"

# ─── Frontend URL (for verification links in emails/PDFs) ─
# The frontend is served by this same Node.js server — leave this matching PORT.
FRONTEND_URL=http://localhost:5000
